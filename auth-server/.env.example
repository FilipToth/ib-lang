# auth-server reads NO variables through dotenv -- it has no dotenv dependency.
# This file documents the one credential the process can consume, which the
# Google auth library picks up straight from the environment.
#
# Local:  export GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/service-account.json
# Docker: uncomment the auth-server env/volume block in docker-compose.yml
#
# Absolute path to a Firebase service-account JSON, downloaded from
# Firebase console -> Project settings -> Service accounts -> Generate new key.
#
# NOT required today: verifyIdToken() only needs the project ID plus Google's
# public signing certs. You need this the moment you call any other Admin API.
GOOGLE_APPLICATION_CREDENTIALS=
