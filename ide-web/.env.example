# Copy to .env.development.local for local dev (that filename is gitignored).
# CRA inlines these at BUILD time -- they are baked into the bundle and are
# therefore public. Never put a real secret in this file.

# Base URL of the ib_server REST API. MUST end in a trailing slash:
# server.ts builds paths as `${REACT_APP_BACKEND_URL}files`.
REACT_APP_BACKEND_URL=http://localhost:8080/api/

# ib_server websocket endpoint (code execution). Served at the root, not /api.
# The client appends ?token=<firebase id token>; the browser WebSocket API
# cannot set an Authorization header, so the token travels in the query string.
# Use wss:// whenever the page itself is served over https.
REACT_APP_WEBSOCKETS_URL=ws://localhost:8080/wss
