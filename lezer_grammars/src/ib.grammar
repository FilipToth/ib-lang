@top Program { Atom* }

@skip { space | LineComment }

Atom {
  IfStatement
  | FunctionDeclaration
  | OutputStatement
  | ReturnStatement
  | ForStatement
  | WhileStatement
  | UntilStatement
  | VariableAssignment
  | IndexAssignment
  | ExpressionStatement
}

IfStatement { IfKeyword Expression ThenKeyword Block ElseClause? ~elseif EndKeyword }

// `else if` either continues a chain that shares the one `end`, or opens an
// ordinary nested if with its own. The compiler tells them apart by whether the
// if is on the else's line; this grammar has no lines, so it keeps both
// readings alive and lets the number of `end`s decide.
ElseClause { ElseKeyword (ElseIf | Block) }
ElseIf { IfKeyword Expression ThenKeyword Block ElseClause? ~elseif }
FunctionDeclaration { FunctionKeyword Identifier ParameterList ReturnType? Block EndKeyword }
ExpressionStatement { Expression }
OutputStatement { OutputKeyword Expression ("," Expression)* }
ReturnStatement { ReturnKeyword Expression }
ForStatement { LoopKeyword ForKeyword? Identifier FromKeyword Expression ToKeyword Expression Block EndKeyword }
WhileStatement { LoopKeyword WhileKeyword Expression Block EndKeyword }
UntilStatement { LoopKeyword UntilKeyword Expression Block EndKeyword }

VariableAssignment { Identifier AssignmentOperator Expression }
IndexAssignment { IndexExpression AssignmentOperator Expression }

Block { Atom* }

Parameter { Identifier ":" Type }
ReturnType { "->" Type }

// A type name, optionally with a generic parameter that is itself a type, so
// `Array<Stack<Int>>` nests.
Type { TypeAnnotation ("<" Type ">")? }
ParameterList { "(" (Parameter ("," Parameter)*)? ")" }

@precedence { member @left, binary @left, unary @right }

Expression {
  BinaryExpression
  | UnaryExpression
  | MemberAccessExpression
  | IndexExpression
  | ReferenceEpxression
  | CallExpression
  | ObjectInstantiationExpression
  | Boolean
  | String
  | Number
  | TypeAnnotation
}

// A multi-token expression has to reduce to a single Expression, otherwise a
// loop bound or condition runs on into the Block that follows it -- there is
// no delimiter keyword between them to stop it.
BinaryExpression { Expression !binary (AdditiveOperator | MiscOperator | AndKeyword | OrKeyword | ModKeyword | DivKeyword) Expression }

// only `+`, `-` and NOT can prefix an expression. were every operator allowed,
// a function body could start with `<`, which right after `-> Stack` cannot be
// told apart from the start of a generic parameter.
UnaryExpression { !unary (NotKeyword | AdditiveOperator) Expression }

ReferenceEpxression { Identifier }
CallExpression { Identifier "(" (Atom*)? ")" }
IndexExpression { Expression !member "[" Expression "]" }
ObjectInstantiationExpression { NewKeyword Type "(" ")" }
MemberAccessExpression { Expression !member "." (CallExpression | Identifier) }

Boolean { @specialize<Identifier, "true" | "false"> }

IfKeyword { @specialize<Identifier, "if" | "IF"> }
ThenKeyword { @specialize<Identifier, "then" | "THEN"> }
EndKeyword { @specialize<Identifier, "end" | "END"> }
ElseKeyword { @specialize<Identifier, "else" | "ELSE"> }
OutputKeyword { @specialize<Identifier, "output" | "OUTPUT"> }
FunctionKeyword { @specialize<Identifier, "function" | "FUNCTION"> }
ReturnKeyword { @specialize<Identifier, "return" | "RETURN"> }
NotKeyword { @specialize<Identifier, "not" | "NOT"> }
AndKeyword { @specialize<Identifier, "and" | "AND"> }
OrKeyword { @specialize<Identifier, "or" | "OR"> }
ModKeyword { @specialize<Identifier, "mod" | "MOD"> }
DivKeyword { @specialize<Identifier, "div" | "DIV"> }
LoopKeyword { @specialize<Identifier, "loop" | "LOOP"> }
ForKeyword { @specialize<Identifier, "for" | "FOR"> }
FromKeyword { @specialize<Identifier, "from" | "FROM"> }
ToKeyword { @specialize<Identifier, "to" | "TO"> }
WhileKeyword { @specialize<Identifier, "while" | "WHILE"> }
UntilKeyword { @specialize<Identifier, "until" | "UNTIL"> }
NewKeyword { @specialize<Identifier, "new" | "NEW"> }

TypeAnnotation { @specialize<Identifier,
  "Void"
  | "Int"
  | "String"
  | "Boolean"
  | "Array"
  | "Collection"
  | "Stack"
  | "Queue"
>}

@tokens {
  Identifier { ($[a-zA-Z] | "_")+ }

  String { '"' (!["\\] | "\\" _)* '"' }

  Number { $[0-9]+ }

  LineComment { "#" ![\n]* }

  AdditiveOperator { "+" | "-" }

  MiscOperator { "==" | "!=" | ">=" | "<=" | ">" | "<" | "*" | "/" }

  AssignmentOperator { "=" }

  space { $[ \t\n\r]+ }

  "(" ")" "[" "]" "->"

  @precedence { "->", AdditiveOperator }
}

@detectDelim
