# Every collection type and its methods, in one program.

# --- Array: indexed storage. isEmpty mirrors the other collections. ---
A = new Array<Int>()
output A.isEmpty()
A.push(10)
A.push(20)
output A.isEmpty()
output A.len()
output A.get(0)
output A.get(1)

# --- Array indexing: the index is any Int expression, and the result takes
#     the array's element type ---
SQUARES = new Array<Int>()
SQUARES.push(0)
SQUARES.push(1)
SQUARES.push(4)
output SQUARES[2]
output SQUARES[1 + 1]
output SQUARES[1] + SQUARES[2]

NAMES = new Array<String>()
NAMES.push("Ada")
output NAMES[0]

# the spec's walk over every element
loop POS from 0 to SQUARES.len() - 1
    output SQUARES[POS]
end

# --- Array index writes: overwriting in range, and appending by writing one
#     past the end, which is how the spec fills an array that starts empty ---
SQUARES[0] = 100
SQUARES[1 + 1] = SQUARES[0] + 1
output SQUARES[0]
output SQUARES[2]

REVERSED = new Array<String>()
LETTERS = new Stack<String>()
LETTERS.push("a")
LETTERS.push("b")
loop POS from 0 to 1
    REVERSED[POS] = LETTERS.pop()
end
output REVERSED[0]
output REVERSED[1]

# --- Stack: last in, first out ---
S = new Stack<Int>()
output S.isEmpty()
S.push(1)
S.push(2)
output S.pop()
output S.pop()
output S.isEmpty()

# --- Queue: first in, first out. The generic differs from the Stack above on
#     purpose: both methods name their parameter `item`, and the two must not
#     collide in the caller's scope. ---
Q = new Queue<String>()
output Q.isEmpty()
Q.enqueue("first")
Q.enqueue("second")
output Q.dequeue()
output Q.dequeue()
output Q.isEmpty()

# --- Collection: the spec names the iteration accessor getNext ---
C = new Collection<Int>()
output C.isEmpty()
C.addItem(30)
C.addItem(40)
output C.isEmpty()
C.resetNext()
output C.getNext()
output C.getNext()

# --- the spec's guaranteed-iteration idiom ---
NUMS = new Collection<Int>()
NUMS.addItem(1)
NUMS.addItem(2)
NUMS.addItem(3)
NUMS.resetNext()
loop while NUMS.hasNext()
    output NUMS.getNext()
end

# --- resetNext restarts the walk ---
NUMS.resetNext()
output NUMS.getNext()

# --- the same method on the same type with different generics ---
NUMS2 = new Stack<Int>()
WORDS = new Stack<String>()
NUMS2.push(11)
WORDS.push("eleven")
output NUMS2.pop()
output WORDS.pop()

# --- a user variable may share a name with a method parameter. `item` and
#     `index` are ordinary identifiers, not reserved words. ---
item = "untouched"
index = "also untouched"
MIXED = new Array<Int>()
MIXED.push(99)
output MIXED.get(0)
output item
output index

# --- method arguments are the caller's expressions, so they can use its
#     variables ---
VALUES = new Array<Int>()
FIVE = 5
VALUES.push(FIVE)
VALUES.push(FIVE * 2)
output VALUES[1]

# --- collections of collections, reached by chaining indexes and calls ---
GRID = new Array<Array<Int>>()
ROW = new Array<Int>()
ROW.push(1)
ROW.push(2)
GRID.push(ROW)
output GRID[0].len()
output GRID[0][1]

# elements are shared, not copied: writing through GRID changes ROW
GRID[0][1] = 9
output ROW[1]

PILES = new Array<Stack<String>>()
PILES.push(new Stack<String>())
PILES[0].push("top")
output PILES[0].pop()
output PILES[0].isEmpty()

# --- collections as parameters and return values ---
function total(NUMBERS: Array<Int>) -> Int
    SUM = 0
    loop I from 0 to NUMBERS.len() - 1
        SUM = SUM + NUMBERS[I]
    end
    return SUM
end

function single(ITEM: Int) -> Stack<Int>
    RESULT = new Stack<Int>()
    RESULT.push(ITEM)
    return RESULT
end

output total(VALUES)
output single(3).pop()

# --- the spec's copy-in-reverse: a method call as another method's argument ---
SURVEY = new Collection<String>()
SURVEY.addItem("first")
SURVEY.addItem("second")
MYSTACK = new Stack<String>()
MYARRAY = new Array<String>()
COUNT = 0
SURVEY.resetNext()
loop while SURVEY.hasNext()
    MYSTACK.push(SURVEY.getNext())
    COUNT = COUNT + 1
end
loop POS from 0 to COUNT - 1
    MYARRAY[POS] = MYSTACK.pop()
end
output MYARRAY[0]
output MYARRAY[1]

# --- a collection prints as its elements, in the order they went in, and each
#     element prints the same way, so nested collections nest ---
SHOWN = new Array<Int>()
output SHOWN
SHOWN.push(1)
SHOWN.push(2)
output SHOWN
output "items: " + SHOWN

NESTED = new Array<Array<Int>>()
NESTED.push(SHOWN)
NESTED.push(new Array<Int>())
output NESTED

PLATES = new Stack<String>()
PLATES.push("a")
PLATES.push("b")
output PLATES

# a queue prints front first, the order it dequeues in
LINE = new Queue<String>()
LINE.enqueue("first")
LINE.enqueue("second")
output LINE
output LINE.dequeue()
output LINE

PICKS = new Collection<Int>()
PICKS.addItem(7)
output PICKS
